# Copy this file to .env and fill it in. .env stays on your machine; git ignores it.

# The bot's token, from the Discord Developer Portal: your application, then "Bot",
# then "Reset Token".
DISCORD_TOKEN=

# Optional: the ID of your test server. Commands then appear there at once.
# Without it they are registered for every server the bot is in.
GUILD_ID=

# Optional: where the bot keeps each server's settings. Default: data/nexo.sqlite
DATABASE_PATH=
